<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050811"
    android:keepScreenOn="true">

    <!-- CAPA 0: Stream de Video MJPEG en Vivo desde la ESP32-CAM (http://IP:81/stream) -->
    <ImageView
        android:id="@+id/ivEsp32Stream"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="Stream de cámara ESP32-CAM" />

    <!-- Vista de Cámara Opcional de respaldo (cuando se usa solo Bluetooth) -->
    <TextureView
        android:id="@+id/cameraTextureView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- CAPA 1: Scrim Oscuro Sutil -->
    <View
        android:id="@+id/cameraOverlayScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#22050811" />

    <!-- CAPA 1.2: Mira HUD y Recuadros IA para Seguimiento de Objetos en el Auto -->
    <com.grupo1.controlauto.TrackingOverlayView
        android:id="@+id/carTrackingOverlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- CAPA 1.5: Estado de Conexión de Video FPV ESP32-CAM (se oculta al recibir el primer frame MJPEG) -->
    <LinearLayout
        android:id="@+id/layoutCarVideoPlaceholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="28dp"
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/hud_panel_bg"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CÁMARA FPV ESP32-CAM (MJPEG :81/stream)"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCarVideoStatusHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Conéctate al Wi-Fi 'AutoRobot_Grupo1' (clave: 12345678)\no toca CONECTAR AUTO para ver el video en vivo"
            android:textColor="#94A3B8"
            android:textSize="10.5sp" />
    </LinearLayout>

    <!-- CAPA 2: Cabina HUD Táctica del Auto Robot 4WD (Diseño Unificado con Dron) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- BARRA SUPERIOR IZQUIERDA: MENÚ + PARADA EMERGENCIA + TELEMETRÍA BT -->
        <LinearLayout
            android:id="@+id/topBarLeftGroupCar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnBackMenu"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="Menú"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_menu_style"
                    app:backgroundTint="@null"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />

                <Button
                    android:id="@+id/btnEmergencyCar"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:layout_marginStart="8dp"
                    android:text="PARADA [S]"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_emergency_red"
                    app:backgroundTint="@null"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />
            </LinearLayout>

            <!-- Píldora de Estado Wi-Fi ESP32-CAM y Sensor Ultrasónico -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/status_pill_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="WIFI: DESCONECTADO | MODO: MANUAL | SONAR: -- cm"
                android:textColor="#E2E8F0"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- BARRA SUPERIOR DERECHA: CONECTAR AUTO, CÁMARA, GUÍA Y CAMBIO A DRON -->
        <LinearLayout
            android:id="@+id/topBarRightButtons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true">

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="CONECTAR AUTO"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/btn_blue_header"
                app:backgroundTint="@null"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginEnd="5dp" />

            <Button
                android:id="@+id/btnToggleTrackingCar"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="SEGUIR IA: OFF"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/btn_hover_cyan"
                app:backgroundTint="@null"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginEnd="5dp" />

            <Button
                android:id="@+id/btnToggleCameraCar"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="CAM ON"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/btn_menu_style"
                app:backgroundTint="@null"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnHelpGuideCar"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="Guía"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/btn_blue_header"
                app:backgroundTint="@null"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnSwitchDrone"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="Dron"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/btn_menu_style"
                app:backgroundTint="@null"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />

            <!-- Botón oculto de compatibilidad -->
            <Button
                android:id="@+id/btnDisconnect"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- MANDOS INFERIORES IZQUIERDA: POD DE DIRECCIÓN (IZQUIERDA / DERECHA) -->
        <LinearLayout
            android:id="@+id/layoutLeftTurn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DIRECCIÓN (L · R)"
                android:textColor="#94A3B8"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/hud_dpad_glass_bg"
                android:padding="8dp">

                <Button
                    android:id="@+id/btnLeft"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="◀"
                    android:textColor="#38BDF8"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_hover_cyan"
                    app:backgroundTint="@null"
                    android:layout_marginEnd="10dp" />

                <Button
                    android:id="@+id/btnRight"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="▶"
                    android:textColor="#38BDF8"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_hover_cyan"
                    app:backgroundTint="@null" />
            </LinearLayout>
        </LinearLayout>

        <!-- CONSOLA CENTRAL INFERIOR: MONITOR UART + BOTÓN FRENAR + MODO VOLANTE -->
        <LinearLayout
            android:id="@+id/layoutCenterControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="2dp">

            <!-- Monitor de Comando Activo y Trama Serial Bluetooth -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/box_status_blue"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tvActiveCommand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FRENADO (STOP)"
                    android:textColor="#00E5FF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGyroData"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UART BT -> [S]  (En espera)"
                    android:textColor="#E2E8F0"
                    android:fontFamily="monospace"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Botón Central de Frenado Activo -->
            <Button
                android:id="@+id/btnBigStop"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="■  FRENAR AUTO [S]"
                android:textColor="#38BDF8"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:background="@drawable/btn_hover_cyan"
                app:backgroundTint="@null"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:layout_marginBottom="5dp" />

            <!-- Píldora Inferior de Modo Volante (Giroscopio) + Botón Centrar -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/status_pill_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Modo Volante (Giro):"
                    android:textColor="#CBD5E1"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="6dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchGyro"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp" />

                <Button
                    android:id="@+id/btnCalibrateGyro"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="Centrar"
                    android:textColor="#FBBF24"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@android:color/transparent"
                    android:paddingStart="6dp"
                    android:paddingEnd="4dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- MANDOS INFERIORES DERECHA: SERVO CÁMARA (ARRIBA/ABAJO) + POD DE TRACCIÓN (AVANZAR / RETROCEDER) -->
        <LinearLayout
            android:id="@+id/layoutRightDrive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true">

            <!-- Control de Servo Vertical de Cámara (U0T / GPIO 1) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/status_pill_bg"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginBottom="6dp">

                <Button
                    android:id="@+id/btnServoUp"
                    android:layout_width="44dp"
                    android:layout_height="28dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="▲CÁM"
                    android:textColor="#4ADE80"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_takeoff_green"
                    app:backgroundTint="@null"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnServoCenter"
                    android:layout_width="50dp"
                    android:layout_height="28dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="45°"
                    android:textColor="#38BDF8"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_hover_cyan"
                    app:backgroundTint="@null"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnServoDown"
                    android:layout_width="44dp"
                    android:layout_height="28dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="▼CÁM"
                    android:textColor="#FCD34D"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_land_amber"
                    app:backgroundTint="@null" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TRACCIÓN (F · B)"
                android:textColor="#94A3B8"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/hud_dpad_glass_bg"
                android:padding="8dp">

                <Button
                    android:id="@+id/btnForward"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="▲"
                    android:textColor="#4ADE80"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_takeoff_green"
                    app:backgroundTint="@null"
                    android:layout_marginEnd="10dp" />

                <Button
                    android:id="@+id/btnBackward"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="▼"
                    android:textColor="#FCD34D"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_land_amber"
                    app:backgroundTint="@null" />
            </LinearLayout>
        </LinearLayout>

        <!-- Banner Central de Alerta Antichoque (Sensor Ultrasónico HC-SR04) -->
        <LinearLayout
            android:id="@+id/overlayWallAlert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/wall_alert_center_bg"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:gravity="center"
            android:layout_centerInParent="true"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvWallAlertTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠ ¡OBSTÁCULO DETECTADO A MENOS DE 10 CM!"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Freno autónomo activado por Arduino Uno + ESP32-CAM (HC-SR04) · Retrocede o gira para despejar"
                android:textColor="#FECACA"
                android:textSize="11sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

    </RelativeLayout>
</FrameLayout>
