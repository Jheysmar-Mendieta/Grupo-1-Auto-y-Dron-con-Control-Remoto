<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ControlAuto" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/cyan_accent</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <!-- Garantizar multitouch simultáneo de ambos pulgares en todos los fabricantes Android -->
        <item name="android:windowEnableSplitTouch">true</item>
        <item name="android:splitMotionEvents">true</item>
    </style>
</resources>
