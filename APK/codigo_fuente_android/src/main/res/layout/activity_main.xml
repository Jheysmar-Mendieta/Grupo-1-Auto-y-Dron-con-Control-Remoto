<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="16dp"
    android:gravity="center_horizontal">

    <!-- Header institucional -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GRUPO 1 - AUTO ROBOT"
        android:textColor="@color/cyan_accent"
        android:textSize="20sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:layout_marginTop="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Control Bluetooth HC-05 - GEdeCon 2026"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        android:layout_marginBottom="12dp" />

    <!-- Tarjeta de Conexión -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/card_dark"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CONECTAR HC-05"
                android:backgroundTint="@color/blue_steer"
                android:textColor="@color/text_white"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnDisconnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DESCONECTAR"
                android:backgroundTint="#475569"
                android:textColor="@color/text_white" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estado: Desconectado"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Tarjeta de Modo Giroscopio / Sensores -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/card_dark"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Control por Giroscopio"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchGyro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvGyroData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Giroscopio inactivo (Usa botones abajo)"
            android:textColor="@color/cyan_accent"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- Pad Direccional -->
    <GridLayout
        android:id="@+id/gridPad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="3"
        android:layout_gravity="center"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="10dp">

        <!-- Fila 0 -->
        <View android:layout_width="85dp" android:layout_height="75dp" />
        
        <Button
            android:id="@+id/btnForward"
            android:layout_width="95dp"
            android:layout_height="75dp"
            android:text="ADELANTE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:backgroundTint="@color/green_go"
            android:textColor="@color/text_white" />

        <View android:layout_width="85dp" android:layout_height="75dp" />

        <!-- Fila 1 -->
        <Button
            android:id="@+id/btnLeft"
            android:layout_width="95dp"
            android:layout_height="75dp"
            android:text="IZQ"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="@color/blue_steer"
            android:textColor="@color/text_white" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="95dp"
            android:layout_height="75dp"
            android:text="STOP\n(S)"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="@color/red_stop"
            android:textColor="@color/text_white" />

        <Button
            android:id="@+id/btnRight"
            android:layout_width="95dp"
            android:layout_height="75dp"
            android:text="DER"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="@color/blue_steer"
            android:textColor="@color/text_white" />

        <!-- Fila 2 -->
        <View android:layout_width="85dp" android:layout_height="75dp" />

        <Button
            android:id="@+id/btnBackward"
            android:layout_width="95dp"
            android:layout_height="75dp"
            android:text="ATRAS"
            android:textSize="11sp"
            android:textStyle="bold"
            android:backgroundTint="@color/orange_rev"
            android:textColor="@color/text_white" />

        <View android:layout_width="85dp" android:layout_height="75dp" />
    </GridLayout>

    <!-- Indicador de instrucción -->
    <TextView
        android:id="@+id/tvHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mantené presionado para mover - Soltá para frenar"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        android:layout_marginBottom="8dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Footer -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Integrantes: Onesti - Silvero - Mendieta"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        android:layout_marginBottom="4dp" />

</LinearLayout>
